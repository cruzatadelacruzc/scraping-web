PORT=3001
DB_URI=mongodb://root:password@localhost:27017/revolico?authSource=admin
DB_ROOT_PASSWORD=password
DB_ROOT_USERNAME=root
DB_NAME=booking
VOL_DIR=/srv/volumes
NODE_ENV=development
TIME_OUT=300
REDIS_URL=redis://localhost:6379
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
PRODUCT_URLS_BATCHSIZE=30
PRODUCT_STORAGE_BATCHSIZE=50
BULL_AREANA_URL=/arena

# Path to a Chrome/Chromium binary used by the scraping service.
# Dev:  /usr/bin/google-chrome-stable   (apt install google-chrome-stable)
# Prod: /usr/bin/chromium               (installed in the Docker image)
# Required — the app throws at boot if unset.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
TENANT_DB_URL=postgresql://revolico:revolico@localhost:5432/revolico
GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRATION=1d
SUPER_ADMIN_EMAIL=admin@scrapper.local
SUPER_ADMIN_PASSWORD=ChangeMe123
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
FACEBOOK_ISSUERS=https://www.facebook.com,https://facebook.com
FACEBOOK_JWKS_URI=https://www.facebook.com/.well-known/oauth/openid/jwks/
FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID

# ─── Bots / WhatsApp / Telegram ────────────────────────────────────────

# --- Provider selection ---
# Bot types to enable. Comma-separated: "whatsapp" | "telegram" | "both" | "none"
BOT_ENABLED=none

# Concrete provider implementation per bot type.
# telegram → telegram (default, @builderbot-plugins/telegram / Telegraf)
BOT_TELEGRAM_PROVIDER=telegram
# whatsapp → baileys (default, @builderbot/provider-baileys / Baileys)
# Future: meta, twilio, etc.
BOT_WHATSAPP_PROVIDER=baileys

# --- Ports ---
# Base port for bot HTTP servers. Each bot type gets basePort + index (0, 1, …).
BOT_HTTP_PORT=3001
# Optional per-bot overrides (take precedence over BOT_HTTP_PORT + index).
# BOT_TELEGRAM_PORT=4000
# BOT_WHATSAPP_PORT=4001

# --- WhatsApp ---
# Baileys session name (persisted on disk under ./<name>_sessions)
WHATSAPP_SESSION_NAME=bazaarsentinel-bot
# Pairing code flow — accept a WhatsApp notification instead of scanning QR.
# NOTE: timing bug in the Baileys provider (calls requestPairingCode before the
# WebSocket connects). QR is recommended. Scan at http://localhost:<WHATSAPP_PORT>/.
WHATSAPP_USE_PAIRING=false
# Phone number with country code, required only when WHATSAPP_USE_PAIRING=true.
WHATSAPP_PHONE_NUMBER=+1xxxxxxxx

# --- Telegram ---
# Telegram bot token (from @BotFather). Required when BOT_ENABLED includes "telegram".
TELEGRAM_BOT_TOKEN=

# --- Network ---
# Force IPv4 for specific provider hostnames (comma-separated: telegram, whatsapp).
# Needed when IPv6 is unreachable. Only affects bot provider connections.
BOT_FORCE_IPV4=telegram

# --- General ---
# Public base URL of the web app — used to build deep links in welcome messages.
WEB_APP_BASE_URL=http://localhost:3000
# OpenAI key used by the LangChain AI layer (optional in dev; AI falls back to a canned response if absent).
OPENAI_API_KEY=

# ─── LLM Keyword Extraction ──────────────────────────────────────────────

# Provider-agnostic LLM configuration for product keyword extraction.
# Uses Vercel AI SDK with @ai-sdk/openai-compatible — any OpenAI-compatible
# API works (DeepSeek, OpenAI, Anthropic, custom proxies, etc.).
# Just set the base URL, model, and API key.

# Base URL of the OpenAI-compatible API endpoint.
# Examples:
#   DeepSeek:  https://api.deepseek.com/v1
#   OpenAI:    https://api.openai.com/v1
#   Anthropic: https://api.anthropic.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# Model name. Current DeepSeek models: deepseek-v4-flash (fast/cheap), deepseek-v4-pro.
# Other providers: gpt-4o-mini, claude-haiku-4-5, etc.
LLM_MODEL=deepseek-v4-flash
# API key for the configured provider.
LLM_API_KEY=
# LLM temperature (0-2). 0 = deterministic, 0.3 = slightly creative, 1 = creative.
# For keyword extraction, 0 or 0.3 recommended. Default: 0.
LLM_TEMPERATURE=0
# Enable DeepSeek-style thinking/reasoning mode. Default: true.
# Set to false on simple extraction tasks to save tokens (~65% fewer tokens).
LLM_ENABLE_REASONING=true
# Custom system prompt for keyword extraction. Optional — if set, overrides
# the hardcoded fallback but is overridden by the DB-stored prompt
# (ScraperConfig with storeKey="llm:keyword-extraction-prompt").
# LLM_KEYWORD_EXTRACTION_PROMPT=
# Number of days before a cached keyword entry expires from MongoDB.
# Default: 30. Set to 0 to disable cache expiry.
LLM_CACHE_TTL_DAYS=30
# Price per 1M input tokens (USD) for estimating prompt-cache savings.
# Examples: DeepSeek $0.14, OpenAI $2.50, Anthropic $3.00.
# Optional — if not set, estimatedSavingsUSD in the enrichment metrics
# endpoint will be 0.
LLM_COST_PER_MILLION_TOKENS=0.14
# MongoDB collection for LangChain per-tenant conversation history.
MONGODB_BOT_HISTORY_COLL=bot_ai_history
# Link code TTL in minutes.
BOT_LINK_CODE_TTL_MINUTES=10
# Outbound send queue concurrency (rate-limit guard for WhatsApp).
BOT_OUTBOUND_CONCURRENCY=5