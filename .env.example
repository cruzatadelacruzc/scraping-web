PORT=3001
DB_URI=mongodb://root:password@localhost:27017/revolico?authSource=admin
DB_ROOT_PASSWORD=password
DB_ROOT_USERNAME=root
DB_NAME=booking
VOL_DIR=/srv/volumes
NODE_ENV=development
TIME_OUT=300
REDIS_URL=redis://localhost:6379
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
PRODUCT_URLS_BATCHSIZE=30
PRODUCT_STORAGE_BATCHSIZE=50
BULL_AREANA_URL=/arena

# Path to a Chrome/Chromium binary used by the scraping service.
# Dev:  /usr/bin/google-chrome-stable   (apt install google-chrome-stable)
# Prod: /usr/bin/chromium               (installed in the Docker image)
# Required — the app throws at boot if unset.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
TENANT_DB_URL=postgresql://revolico:revolico@localhost:5432/revolico
GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRATION=1d
SUPER_ADMIN_EMAIL=admin@scrapper.local
SUPER_ADMIN_PASSWORD=ChangeMe123
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
FACEBOOK_ISSUERS=https://www.facebook.com,https://facebook.com
FACEBOOK_JWKS_URI=https://www.facebook.com/.well-known/oauth/openid/jwks/
FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID

# ─── Bots / WhatsApp / Telegram ────────────────────────────────────────
# Bot provider selection. One of: "whatsapp" | "telegram" | "both" | "none"
BOT_ENABLED=none
# Baileys session name (persisted on disk under ./baileys_auth)
WHATSAPP_SESSION_NAME=price-monitor-bot
# Telegram bot token (from @BotFather). Required only if BOT_ENABLED includes "telegram".
TELEGRAM_BOT_TOKEN=
# Public base URL of the web app — used to build deep links in welcome messages.
WEB_APP_BASE_URL=http://localhost:3000
# OpenAI key used by the LangChain AI layer (optional in dev; AI falls back to a canned response if absent).
OPENAI_API_KEY=
# MongoDB collection for LangChain per-tenant conversation history.
MONGODB_BOT_HISTORY_COLL=bot_ai_history
# Link code TTL in minutes.
BOT_LINK_CODE_TTL_MINUTES=10
# Outbound send queue concurrency (rate-limit guard for WhatsApp).
BOT_OUTBOUND_CONCURRENCY=5