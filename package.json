{
  "name": "bazaarsentinel",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS for marketplace listing monitoring — watch prices, views, sellers, and outstanding status across online bazaars like Revolico.",
  "main": "dist/main/bootstrap.js",
  "scripts": {
    "test": "NODE_ENV=test jest --verbose",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --verbose --collectCoverage",
    "start": "node -r ./baileys-preload.cjs ./dist/main/bootstrap.js",
    "clean": "rimraf ./dist",
    "build": "npm run clean && npm run docs:generate && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "docs:generate": "ts-node -O '{\"types\":[\"node\"]}' -r tsconfig-paths/register src/main/docs/generate.ts",
    "docs:validate": "ts-node -O '{\"types\":[\"node\"]}' -r tsconfig-paths/register src/main/docs/generate.ts /tmp/swagger-check.json --silent && diff -q swagger.json /tmp/swagger-check.json || { echo 'swagger.json is out of sync. Run npm run docs:generate.'; exit 1; }",
    "dev": "TS_NODE_FILES=true ts-node-dev -r ./baileys-preload.cjs -r tsconfig-paths/register --respawn src/main/bootstrap.ts",
    "format": "prettier -uw --cache src/**/*.{js,ts,json,yaml}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "[[ $NODE_ENV != 'production' ]] && husky || exit 0",
    "migrate:dev": "prisma migrate dev",
    "seed": "ts-node -O '{\"types\":[\"node\"]}' prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node -O '{\"types\":[\"node\"]}' prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@eslint/js": "^9.12.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.2.10",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "3.3.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.9.0"
  },
  "dependencies": {
    "@builderbot-plugins/telegram": "^2.0.0",
    "@builderbot/bot": "^1.2.0",
    "@builderbot/provider-baileys": "^1.4.3-y.4",
    "@bull-board/api": "^5.23.0",
    "@bull-board/express": "^5.23.0",
    "@langchain/core": "^0.3.0",
    "@langchain/mongodb": "^0.1.0",
    "@langchain/openai": "^0.3.0",
    "@prisma/client": "^6.10.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.4",
    "baileys": "^7.0.0-rc13",
    "bcryptjs": "^3.0.2",
    "body-parse": "^0.1.0",
    "bullmq": "^5.78.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.20.0",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "jose": "^6.1.0",
    "jsonata": "^2.2.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.0",
    "module-alias": "^2.2.3",
    "mongoose": "^8.6.0",
    "nanoid": "^3.3.7",
    "node-cron": "^3.0.3",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "prisma": "^6.10.1",
    "puppeteer-core": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.67"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
