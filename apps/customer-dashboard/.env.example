# API Configuration
VITE_API_URL=http://localhost:3000

# App Configuration
VITE_APP_NAME=BazaarSentinel

# VAPID Public Key for Web Push (generated by backend)
VITE_VAPID_PUBLIC_KEY=

# Enable MSW (Mock Service Worker) for offline development
# Set to "true" only when backend is not running
VITE_MSW_ENABLED=false